{% extends "base.html" %}
{% load static %}

{% block title %}
Bütçe ve Raporlar | Glauria ERP
{% endblock %}

{% block extra_css %}
    <link
        rel="stylesheet"
        href="{% static 'css/finance.css' %}?v=budget-list-v3"
    >
{% endblock %}

{% block content %}
<section class="module-page finance-dashboard">
    {% include "components/page_header.html" with eyebrow="FİNANS VE MUHASEBE" title="Bütçe ve Raporlar" description="Bütçe hedeflerinizi oluşturun, aylık nakit planınızı takip edin ve gerçekleşen hareketlerle karşılaştırın." %}
    <div class="finance-budget-toolbar">
    <a
        href="{% url 'finance:budget_accounts' %}"
        class="finance-budget-toolbar__action"
    >
        Bütçe Kontrol Hesapları
    </a>
</div>


<div class="finance-metrics finance-budget-portfolio__metrics">
    <article class="finance-metric-card finance-metric-card--primary">
        <span class="finance-metric-card__label">
            AKTİF BÜTÇE NET PLANI
        </span>
        <strong class="finance-metric-card__value">
            ₺{{ active_budget_net_total|floatformat:2 }}
        </strong>
        <span class="finance-metric-card__meta">
            Aktif bütçelerin net nakit hedefi
        </span>
    </article>

    <article class="finance-metric-card">
        <span class="finance-metric-card__label">
            AKTİF PLANLANAN GİRİŞ
        </span>
        <strong class="finance-metric-card__value finance-metric-card__value--positive">
            ₺{{ active_budget_totals.planned_inflow|floatformat:2 }}
        </strong>
        <span class="finance-metric-card__meta">
            Aktif bütçelerin toplam gelir hedefi
        </span>
    </article>

    <article class="finance-metric-card">
        <span class="finance-metric-card__label">
            AKTİF PLANLANAN ÇIKIŞ
        </span>
        <strong class="finance-metric-card__value finance-metric-card__value--warning">
            ₺{{ active_budget_totals.planned_outflow|floatformat:2 }}
        </strong>
        <span class="finance-metric-card__meta">
            Aktif bütçelerin toplam gider hedefi
        </span>
    </article>

    <article class="finance-metric-card">
        <span class="finance-metric-card__label">
            ONAY BEKLEYEN BÜTÇE
        </span>
        <strong class="finance-metric-card__value">
            {{ status_counts.pending_approval|default:0 }}
        </strong>
        <span class="finance-metric-card__meta">
            Yönetici onayı bekleyen taslaklar
        </span>
    </article>
</div>

<section class="finance-panel finance-budget-portfolio">
    <div class="finance-panel__heading">
        <div>
            <span class="finance-panel__eyebrow">
                BÜTÇE PORTFÖYÜ
            </span>

            <h3 class="finance-panel__title">
                Bütçe Durum Dağılımı
            </h3>
        </div>

        <span class="finance-panel__count">
            {{ status_counts.active|default:0 }} aktif bütçe
        </span>
    </div>

    <div class="finance-budget-portfolio__grid">
        <div class="finance-budget-portfolio__chart">
            <canvas id="finance-budget-portfolio-chart"></canvas>
        </div>

        <div class="finance-budget-portfolio__statuses">
            <div>
                <span>Taslak</span>
                <strong>{{ status_counts.draft|default:0 }}</strong>
            </div>

            <div>
                <span>Onay bekliyor</span>
                <strong>{{ status_counts.pending_approval|default:0 }}</strong>
            </div>

            <div>
                <span>Aktif</span>
                <strong>{{ status_counts.active|default:0 }}</strong>
            </div>

            <div>
                <span>Kapandı</span>
                <strong>{{ status_counts.closed|default:0 }}</strong>
            </div>
        </div>
    </div>
</section>

{{ budget_portfolio_chart|json_script:"finance-budget-portfolio-chart-data" }}

    <div class="finance-dashboard__grid">
        <section class="finance-panel finance-panel--wide">
            <div class="finance-panel__heading">
                <div>
                    <span class="finance-panel__eyebrow">
                        BÜTÇELER
                    </span>

                    <h3 class="finance-panel__title">
                        Bütçe Planları
                    </h3>
                </div>

                <span class="finance-panel__count">
                    {{ budgets|length }} bütçe
                </span>
            </div>

            <div class="finance-budget-filters">
    <a
        href="{% url 'finance:budget_reports' %}"
        class="finance-budget-filter{% if not selected_status %} finance-budget-filter--active{% endif %}"
    >
        Tümü
    </a>

    {% for status_value, status_label in budget_status_choices %}
        <a
            href="{% url 'finance:budget_reports' %}?status={{ status_value }}"
            class="finance-budget-filter{% if selected_status == status_value %} finance-budget-filter--active{% endif %}"
        >
            {{ status_label }}
        </a>
    {% endfor %}
</div>

            {% if budgets %}
                <div class="data-table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Bütçe</th>
                                <th>Mali yıl</th>
                                <th>Revizyon</th>
                                <th>Planlanan giriş</th>
                                <th>Planlanan çıkış</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for budget in budgets %}
                                <tr>
                                    <td>
                                        <div class="customer-cell">
                                            <a
    href="{% url 'finance:budget_detail' budget.id %}"
    class="finance-plan-link"
>
    {{ budget.name }}
</a>
                                            <span>
                                                {{ budget.description|default:"Bütçe açıklaması girilmedi." }}
                                            </span>
                                        </div>
                                    </td>
                                    <td>{{ budget.fiscal_year }}</td>
                                    <td>
    <div class="finance-budget-revision">
        {% if budget.source_budget %}
            <strong>Rev.{{ budget.revision_number }}</strong>

            <a
                href="{% url 'finance:budget_detail' budget.source_budget.id %}"
            >
                ← {{ budget.source_budget.name }}
            </a>
        {% else %}
            <span>İlk sürüm</span>
        {% endif %}
    </div>
</td>
                                    <td class="finance-amount--positive">
                                        ₺{{ budget.planned_inflow_total|floatformat:2 }}
                                    </td>
                                    <td class="finance-amount--negative">
                                        ₺{{ budget.planned_outflow_total|floatformat:2 }}
                                    </td>
                                    <td>
                                        {% if budget.status == "active" %}
                                            <span class="status-pill status-pill--active">
                                                Aktif
                                            </span>

                                        {% elif budget.status == "pending_approval" %}
    <span class="status-pill status-pill--lead">
        Onay bekliyor
    </span>
                                        {% elif budget.status == "closed" %}
                                            <span class="status-pill">
                                                Kapandı
                                            </span>
                                        {% else %}
                                            <span class="status-pill status-pill--lead">
                                                Taslak
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="finance-panel__empty">
                    Henüz bir bütçe planı bulunmuyor. Sağdaki formdan
                    ilk bütçe taslağınızı oluşturabilirsiniz.
                </div>
            {% endif %}
        </section>

        <section class="finance-panel">
            <div class="finance-panel__heading">
                <div>
                    <span class="finance-panel__eyebrow">
                        YENİ BÜTÇE
                    </span>

                    <h3 class="finance-panel__title">
                        Bütçe Taslağı Oluştur
                    </h3>
                </div>
            </div>

            <form method="post" class="finance-form">
                {% csrf_token %}

                {% if form.non_field_errors %}
                    <div class="finance-form__errors">
                        {{ form.non_field_errors }}
                    </div>
                {% endif %}

                {% for field in form %}
                    <div class="finance-form__field">
                        <label for="{{ field.id_for_label }}">
                            {{ field.label }}
                        </label>
                        {{ field }}
                        {{ field.errors }}
                    </div>
                {% endfor %}

                <button type="submit" class="finance-form__submit">
                    Bütçe Oluştur
                </button>
            </form>
        </section>
    </div>
</section>
{% endblock %}
{% block extra_js %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>

<script>
    const portfolioChartDataElement = document.getElementById(
        "finance-budget-portfolio-chart-data"
    );

    const portfolioChartCanvas = document.getElementById(
        "finance-budget-portfolio-chart"
    );

    if (portfolioChartDataElement && portfolioChartCanvas) {
        const portfolioChartData = JSON.parse(
            portfolioChartDataElement.textContent
        );

        const isLightTheme = (
            document.documentElement.dataset.theme === "light"
        );

        const totalBudgetCount = portfolioChartData.values.reduce(
            (total, value) => total + Number(value || 0),
            0
        );

        const centerTextPlugin = {
            id: "financeBudgetCenterText",

            afterDraw(chart) {
                const {
                    ctx,
                    chartArea,
                } = chart;

                if (!chartArea) {
                    return;
                }

                const centerX = (
                    chartArea.left + chartArea.right
                ) / 2;

                const centerY = (
                    chartArea.top + chartArea.bottom
                ) / 2;

                ctx.save();
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";

                ctx.fillStyle = isLightTheme
                    ? "#321f29"
                    : "#fff5ef";

                ctx.font = "700 30px Inter, sans-serif";
                ctx.fillText(
                    totalBudgetCount,
                    centerX,
                    centerY - 8
                );

                ctx.fillStyle = isLightTheme
                    ? "rgba(80, 53, 66, 0.62)"
                    : "rgba(255, 239, 232, 0.62)";

                ctx.font = "600 11px Inter, sans-serif";
                ctx.fillText(
                    "TOPLAM BÜTÇE",
                    centerX,
                    centerY + 20
                );

                ctx.restore();
            },
        };

        new Chart(
            portfolioChartCanvas,
            {
                type: "doughnut",

                data: {
                    labels: portfolioChartData.labels,

                    datasets: [
                        {
                            data: portfolioChartData.values,

                            backgroundColor: isLightTheme
                                ? [
                                    "#ead8e9",
                                    "#e8b9a5",
                                    "#b35f7d",
                                    "#4a2d3b",
                                ]
                                : [
                                    "#8f668c",
                                    "#c98972",
                                    "#d77899",
                                    "#ead7df",
                                ],

                            borderColor: isLightTheme
                                ? "#fffaf8"
                                : "#17131c",

                            borderWidth: 3,
                            borderRadius: 8,
                            spacing: 3,
                            hoverOffset: 4,
                        },
                    ],
                },

                plugins: [
                    centerTextPlugin,
                ],

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "78%",
                    rotation: -90,
                    circumference: 360,

                    animation: {
                        duration: 700,
                        easing: "easeOutQuart",
                    },

                    interaction: {
                        intersect: false,
                        mode: "nearest",
                    },

                    plugins: {
                        legend: {
                            display: false,
                        },

                        tooltip: {
                            displayColors: false,
                            backgroundColor: isLightTheme
                                ? "#321f29"
                                : "#f9eee9",

                            titleColor: isLightTheme
                                ? "#ffffff"
                                : "#321f29",

                            bodyColor: isLightTheme
                                ? "#f5ded6"
                                : "#5a3647",

                            padding: 14,
                            cornerRadius: 12,
                            caretPadding: 8,

                            titleFont: {
                                size: 12,
                                weight: "700",
                            },

                            bodyFont: {
                                size: 12,
                                weight: "600",
                            },

                            callbacks: {
                                label(context) {
                                    const value = Number(
                                        context.parsed || 0
                                    );

                                    const percentage = (
                                        totalBudgetCount > 0
                                            ? Math.round(
                                                (
                                                    value
                                                    / totalBudgetCount
                                                ) * 100
                                            )
                                            : 0
                                    );

                                    return (
                                        value
                                        + " bütçe · %"
                                        + percentage
                                    );
                                },
                            },
                        },
                    },
                },
            }
        );
    }
</script>
{% endblock %}